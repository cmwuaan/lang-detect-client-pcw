{
	"name": "zlang",
	"version": "0.1.0",
	"private": true,
	"description": "Language detection through the OS: Apple NaturalLanguage on macOS, Extended Linguistic Services on Windows",
	"main": "index.js",
	"types": "index.d.ts",
	"scripts": {
		"build": "npm run build:node && npm run build:types",
		"build:node": "node scripts/build-node.js",
		"build:node:darwin-arm64": "node scripts/build-node.js aarch64-apple-darwin",
		"build:node:darwin-x64": "node scripts/build-node.js x86_64-apple-darwin",
		"build:node:win32-ia32": "node scripts/build-node.js i686-pc-windows-msvc",
		"build:node:win32-x64": "node scripts/build-node.js x86_64-pc-windows-msvc",
		"build:cpp": "node scripts/build-node.js --impl=cpp",
		"build:cpp:darwin-arm64": "node scripts/build-node.js aarch64-apple-darwin --impl=cpp",
		"build:cpp:darwin-x64": "node scripts/build-node.js x86_64-apple-darwin --impl=cpp",
		"build:cpp:win32-ia32": "node scripts/build-node.js i686-pc-windows-msvc --impl=cpp",
		"build:cpp:win32-x64": "node scripts/build-node.js x86_64-pc-windows-msvc --impl=cpp",
		"build:types": "tsc -p tsconfig.json",
		"win7-guard": "node scripts/win7-guard.js",
		"test": "node scripts/smoke.js"
	},
	"devDependencies": {
		"@types/node": "17.0.35",
		"typescript": "3.9.6"
	}
}
