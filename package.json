{
	"name": "lang-detect",
	"version": "1.0.0",
	"description": "Language detection app — chạy được cả bản web và bản desktop",
	"engines": {
		"node": ">=22.12"
	},
	"main": "dist/main/main.js",
	"scripts": {
		"clean": "rimraf dist",
		"typecheck": "tsc --noEmit",
		"dev": "node scripts/build.js --watch",
		"dev:pc": "node scripts/build.js --watch --electron",
		"build": "npm-run-all clean build:only",
		"build:only": "node scripts/build.js",
		"start": "npm run build && electron ."
	},
	"keywords": [
		"language detector"
	],
	"author": {
		"name": "Cao Minh Quan",
		"email": "minhquanrbpk@gmail.com"
	},
	"license": "MIT",
	"dependencies": {
		"react": "16.14.0",
		"react-dom": "16.14.0",
		"reflect-metadata": "0.1.13",
		"tsyringe": "4.8.0"
	},
	"devDependencies": {
		"@types/node": "22.15.3",
		"@types/react": "16.14.0",
		"@types/react-dom": "16.9.8",
		"electron": "44.0.0",
		"esbuild": "0.25.10",
		"npm-run-all": "4.1.5",
		"rimraf": "3.0.2",
		"sass": "1.71.1",
		"typescript": "5.9.2"
	}
}
