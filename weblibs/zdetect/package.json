{
	"name": "zdetect",
	"version": "1.0.0",
	"private": true,
	"description": "Pure-JS language detection for the web build — script routing + n-gram + lexicon",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "node scripts/build.js && tsc -p tsconfig.json",
		"train": "node scripts/run-ts.js scripts/train.ts",
		"test": "node scripts/run-ts.js scripts/test.ts",
		"bench": "node scripts/run-ts.js scripts/bench.ts",
		"eval": "node scripts/run-ts.js scripts/eval.ts"
	}
}
