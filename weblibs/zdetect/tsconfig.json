{
	"compilerOptions": {
		/* Chạy trong browser (bản web) lẫn Node (script train/test). */
		"target": "ES2018",
		"module": "esnext",
		"moduleResolution": "node",
		"lib": ["ES2018", "DOM"],

		/* Profile n-gram là JSON được import thẳng, bundler tự inline. */
		"resolveJsonModule": true,

		/* Chỉ phát .d.ts — bundle JS do esbuild lo, xem scripts/build.js. */
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": ".",
		"outDir": "dist/types",

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts"]
}
